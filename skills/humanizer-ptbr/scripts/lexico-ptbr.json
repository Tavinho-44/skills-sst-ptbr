 "structures": [
  {
   "id": "nao-e-sobre",
   "regex": "(?i)\\bnão (?:é|se trata)(?: só| apenas| somente)? (?:sobre |de )?[^.!?\\n]{2,60}[,.;]\\s*(?:é|se trata) (?:sobre|de)\\b",
   "name": "\"Não é sobre X, é sobre Y\"",
   "fix": "Diga direto o Y. A inversão é a marca."
  },
  {
   "id": "nao-apenas",
   "regex": "(?i)\\bnão (?:apenas|só|somente)\\b[^.!?\\n]{2,80}\\bmas também\\b",
   "name": "\"Não apenas X, mas também Y\"",
   "fix": "Separe em duas frases ou corte a metade mais fraca."
  },
  {
   "id": "mais-do-que",
   "regex": "(?i)\\bmais do que [^.!?\\n]{2,60}[,.]\\s*(?:é|são)\\b",
   "name": "\"Mais do que X, é Y\"",
   "fix": "Afirme Y sem a moldura."
  },
  {
   "id": "pergunta-revelacao",
   "regex": "(?im)^\\s*(?:o resultado|a lição|o motivo|a resposta|o detalhe|o problema|spoiler|resultado)\\s*[?:]\\s*$",
   "name": "Linha de revelação (\"O resultado?\", \"Spoiler:\")",
   "fix": "Entregue a informação direto, sem o suspense."
  },
  {
   "id": "trinca",
   "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ e [\\wÀ-ÿ]+[.!]",
   "name": "Lista de três (\"X, Y e Z.\")",
   "fix": "Use dois, quatro ou um item só."
  },
  {
   "id": "emoji-hype",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF\\U0001F4AF]",
   "name": "Emoji de foguete/fogo/lâmpada/brilho/alvo",
   "fix": "Corte ou troque por um emoji com função."
  },
  {
   "id": "parede-hashtag",
   "regex": "(?:#[\\wÀ-ÿ]+[ \\t]*){7,}",
   "name": "Parede de hashtags (7+)",
   "fix": "Fique em 3 a 6 hashtags de nicho."
  },
  {
   "id": "abertura-imagine",
   "regex": "(?im)^\\s*(?:imagine\\b|você sabia que|já parou para pensar)",
   "name": "Abertura \"Imagine...\" / \"Você sabia que...\"",
   "fix": "Comece pelo fato ou pela cena real."
  },
  {
   "id": "fecho-moral",
   "regex": "(?i)\\bsegurança é (?:responsabilidade|compromisso|dever|papel) de todos\\b",
   "name": "Fecho moralista genérico",
   "fix": "Feche com algo que só esse post diria."
  },
  {
   "id": "isca-engajamento",
   "regex": "(?im)(?:concorda\\?|concordam\\?|o que acham\\?|o que vocês acham\\?|faz sentido\\?|quem mais\\b[^\\n]*\\?)\\s*$",
   "name": "Pergunta-isca de engajamento",
   "fix": "Troque por uma pergunta que só este post poderia fazer."
  },
  {
   "id": "gerundismo",
   "regex": "(?i)\\b(?:vou|vamos|vai|vão|estarei|estaremos) estar [\\wÀ-ÿ]+ndo\\b",
   "name": "Gerundismo (\"vamos estar enviando\")",
   "fix": "Use o verbo direto: \"vamos enviar\"."
  },
  {
   "id": "perguntas-empilhadas",
   "regex": "(?:[^\\n?]{3,}\\?[ \\t]*){3,}",
   "name": "Três ou mais perguntas seguidas",
   "fix": "Deixe uma pergunta só."
  },
  {
   "id": "auto-ia",
   "regex": "(?i)\\bcomo (?:uma )?(?:IA|inteligência artificial|modelo de linguagem)\\b",
   "name": "Autorreferência de IA",
   "fix": "Remova."
  }
 ],
 "excecoes": [
  {
   "termos": [
    "jornada"
   ],
   "motivo": "jornada de trabalho é termo legal (CLT, NRs)",
   "contexto": "jornadas?\\s+(?:de\\s+trabalho|diárias?|semanais?|mensais?|noturnas?|extraordinárias?|parciais?|em\\s+turnos?|de\\s+\\d+|de\\s+(?:oito|seis|doze)\\s+horas)|(?:duração|redução|compensação|limite|controle|registro|horário|fora)\\s+(?:d[ae]\\s+|da\\s+)?jornada"
  },
  {
   "termos": [
    "desbloquear"
   ],
   "motivo": "desbloqueio de energia e de dispositivos (LOTO, NR-10, NR-12)",
   "contexto": "(?:energia|energiz\\w+|equipamentos?|dispositivos?|cadeados?|etiquetas?|bloqueios?|LOTO|trav\\w+|válvulas?|máquinas?|painéis|painel|chaves?|circuitos?)(?:\\W+\\w+){0,6}?\\W+desbloquear|desbloquear(?:\\W+\\w+){0,6}?\\W+(?:energia|energiz\\w+|equipamentos?|dispositivos?|cadeados?|etiquetas?|bloqueios?|LOTO|trav\\w+|válvulas?|máquinas?|painéis|painel|chaves?|circuitos?)"
  },
  {
   "termos": [
    "mergulhar"
   ],
   "motivo": "trabalho com mergulho e em meio líquido (NR-15, NR-30, NR-37)",
   "contexto": "(?:mergulho|mergulhador\\w*|hiperbár\\w*|submers\\w*|subaquátic\\w*|cilindros?|tanques?|piscinas?|águas?|NR-?\\s?(?:15|30|37))(?:\\W+\\w+){0,8}?\\W+mergulhar|mergulhar(?:\\W+\\w+){0,8}?\\W+(?:mergulho|mergulhador\\w*|hiperbár\\w*|submers\\w*|subaquátic\\w*|cilindros?|tanques?|piscinas?|águas?|NR-?\\s?(?:15|30|37))"
  },
  {
   "termos": [
    "essencial",
    "essenciais"
   ],
   "motivo": "serviços e atividades essenciais (termo legal)",
   "contexto": "(?:serviços?|atividades?|funções?|setores|setor|bens|bem|nutrientes|aminoácidos|óleos)\\s+(?:públicos\\s+)?essencia(?:l|is)|essencia(?:l|is)\\s+(?:à|a|para)\\s+(?:vida|saúde)"
  },
  {
   "termos": [
    "ecossistema"
   ],
   "motivo": "ecossistema em sentido ambiental (NR-22, NR-31, licenciamento)",
   "contexto": "ecossistemas?\\s+(?:aquáticos?|terrestres?|naturais?|florestais?|marinhos?|costeiros?|locais?|frágeis?)|(?:fauna|flora|biodiversidade|meio\\s+ambiente|ambiental|ambientais|bioma|manguezal)(?:\\W+\\w+){0,6}?\\W+ecossistemas?|ecossistemas?(?:\\W+\\w+){0,6}?\\W+(?:fauna|flora|biodiversidade|meio\\s+ambiente|ambiental|ambientais|bioma)"
  },
  {
   "termos": [
    "fundamental",
    "fundamentais"
   ],
   "motivo": "ensino fundamental e direitos fundamentais (termos legais e de escolaridade)",
   "contexto": "ensino\\s+fundamental|nível\\s+fundamental|fundamental\\s+(?:completo|incompleto)|direitos?\\s+fundamentais|garantias\\s+fundamentais"
  },
  {
   "termos": [
    "transformador",
    "transformadora"
   ],
   "motivo": "transformador elétrico (NR-10, SEP)",
   "contexto": "\\b(?:o|um|do|no|ao|dos|nos|os|de|pelo|pelos)\\s+transformador(?:es)?\\b|transformador(?:es)?\\s+(?:de\\s+(?:potência|distribuição|corrente|potencial|tensão|força)|trifásic\\w+|monofásic\\w+|elétric\\w+|a\\s+óleo|seco|isolador|abaixador|elevador)"
  },
  {
