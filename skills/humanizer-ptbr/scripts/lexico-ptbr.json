 "structures": [
  {
   "id": "nao-e-sobre",
   "regex": "(?i)\\bnão (?:é|se trata)(?: só| apenas| somente)? (?:sobre |de )?[^.!?\\n]{2,60}[,.;]\\s*(?:é|se trata) (?:sobre|de)\\b",
   "name": "\"Não é sobre X, é sobre Y\"",
   "fix": "Diga direto o Y. A inversão é a marca."
  },
  {
   "id": "nao-apenas",
   "regex": "(?i)\\bnão (?:apenas|só|somente)\\b[^.!?\\n]{2,80}\\bmas também\\b",
   "name": "\"Não apenas X, mas também Y\"",
   "fix": "Separe em duas frases ou corte a metade mais fraca."
  },
  {
   "id": "mais-do-que",
   "regex": "(?i)\\bmais do que [^.!?\\n]{2,60}[,.]\\s*(?:é|são)\\b",
   "name": "\"Mais do que X, é Y\"",
   "fix": "Afirme Y sem a moldura."
  },
  {
   "id": "pergunta-revelacao",
   "regex": "(?im)^\\s*(?:o resultado|a lição|o motivo|a resposta|o detalhe|o problema|spoiler|resultado)\\s*[?:]\\s*$",
   "name": "Linha de revelação (\"O resultado?\", \"Spoiler:\")",
   "fix": "Entregue a informação direto, sem o suspense."
  },
  {
   "id": "trinca",
   "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ e [\\wÀ-ÿ]+[.!]",
   "name": "Lista de três (\"X, Y e Z.\")",
   "fix": "Use dois, quatro ou um item só."
  },
  {
   "id": "emoji-hype",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF\\U0001F4AF]",
   "name": "Emoji de foguete/fogo/lâmpada/brilho/alvo",
   "fix": "Corte ou troque por um emoji com função."
  },
  {
   "id": "parede-hashtag",
   "regex": "(?:#[\\wÀ-ÿ]+[ \\t]*){7,}",
   "name": "Parede de hashtags (7+)",
   "fix": "Fique em 3 a 6 hashtags de nicho."
  },
  {
   "id": "abertura-imagine",
   "regex": "(?im)^\\s*(?:imagine\\b|você sabia que|já parou para pensar)",
   "name": "Abertura \"Imagine...\" / \"Você sabia que...\"",
   "fix": "Comece pelo fato ou pela cena real."
  },
  {
   "id": "fecho-moral",
   "regex": "(?i)\\bsegurança é (?:responsabilidade|compromisso|dever|papel) de todos\\b",
   "name": "Fecho moralista genérico",
   "fix": "Feche com algo que só esse post diria."
  },
  {
   "id": "isca-engajamento",
   "regex": "(?im)(?:concorda\\?|concordam\\?|o que acham\\?|o que vocês acham\\?|faz sentido\\?|quem mais\\b[^\\n]*\\?)\\s*$",
   "name": "Pergunta-isca de engajamento",
   "fix": "Troque por uma pergunta que só este post poderia fazer."
  },
  {
   "id": "gerundismo",
   "regex": "(?i)\\b(?:vou|vamos|vai|vão|estarei|estaremos) estar [\\wÀ-ÿ]+ndo\\b",
   "name": "Gerundismo (\"vamos estar enviando\")",
   "fix": "Use o verbo direto: \"vamos enviar\"."
  },
  {
   "id": "perguntas-empilhadas",
   "regex": "(?:[^\\n?]{3,}\\?[ \\t]*){3,}",
   "name": "Três ou mais perguntas seguidas",
   "fix": "Deixe uma pergunta só."
  },
  {
   "id": "auto-ia",
   "regex": "(?i)\\bcomo (?:uma )?(?:IA|inteligência artificial|modelo de linguagem)\\b",
   "name": "Autorreferência de IA",
   "fix": "Remova."
  }
 ]
}