   "contexto": "\\b(?:a|da|na|uma|pela|essa|esta|aquela|cada|as|das|nas|pelas)\\s+alavancas?\\b|alavancas?\\s+d[eoa]s?\\s+(?:bloqueio|comando|freio|câmbio|acionamento|emergência|segurança)"
